---
import resume from '../data/resume.json';
import { SITE } from '../data/site';
---
<footer>
  <a href={`mailto:${SITE.email}`} class="accent">{SITE.email}</a>
  <span class="links">
    <a href={resume.links.github} target="_blank" rel="noopener">GitHub</a>
    <a href={resume.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a href={resume.links.twitter} target="_blank" rel="noopener">Twitter</a>
    <a href="/rss.xml">RSS</a>
  </span>
</footer>

<style>
  footer {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px;
    padding: 28px clamp(24px, 5vw, 56px);
    border-top: 1px solid var(--color-divider);
    font-size: 13px; color: var(--color-neutral-700);
  }
  .links { display: flex; flex-wrap: wrap; gap: 24px; }
</style>
