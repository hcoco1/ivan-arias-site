---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts(); // newest first
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, older: posts[i + 1], newer: posts[i - 1] },
  }));
}

interface Props { post: Post; older?: Post; newer?: Post }
const { post, older, newer } = Astro.props;
const { Content } = await render(post);
---
<PostLayout post={post} older={older} newer={newer}>
  <Content />
</PostLayout>
