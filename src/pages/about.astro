---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import resume from '../data/resume.json';
import { Image } from 'astro:assets';
import portrait from '../assets/ivan.jpg';
---
<BaseLayout title="About" description="Ivan Arias: geological engineer and GIS analyst. Experience, skills and education." current="about">
  <div data-about class="about">
    <aside>
      <h1 class="page-title">About</h1>
      <!-- Portrait + role/location read as one identity block, like a contributor note. -->
      <div class="identity">
        <figure data-noprint class="portrait">
          <Image src={portrait} alt="Portrait of Ivan Arias" width={400} quality={90} loading="eager" />
        </figure>
        <div class="lines">{resume.role}<br />{resume.focus}<br />{resume.location}</div>
      </div>
      <div data-noprint class="actions">
        <!-- The PDF lives in public/, so it is served as-is at this path. -->
        <a href="/Ivan-Arias-CV.pdf" download="Ivan-Arias-CV.pdf" class="btn btn-primary">Download CV (PDF)</a>
      </div>
    </aside>

    <div class="body">
      <p class="lead">I'm a geological engineer who spent thirteen years making maps of what lies underground. Now I build the tools that put those maps on the web.</p>
      <p class="intro justify">At PDVSA, in Venezuela and Ecuador from 2005 to 2018, I built and maintained field-development geodatabases and geologic map series in ArcGIS, integrating well-log, core and seismic data across multiple basins. My MSc research applied geostatistical spatial modelling across 65 exploration wells. Since 2022 I've extended that foundation into Python, PostGIS, spatial SQL, FastAPI and Leaflet, building full-stack web GIS applications.</p>

      <SectionLabel top={72}>Experience</SectionLabel>
      {resume.experience.map((e) => (
        <div data-keep class="exp rule-row">
          <span class="years nums">{e.years}</span>
          <div class="exp-main">
            <span class="exp-title">{e.title}</span>
            <span class="org accent">{e.org}</span>
            <span class="exp-body justify">{e.body}</span>
          </div>
        </div>
      ))}

      <SectionLabel top={64}>Skills</SectionLabel>
      {resume.skills.map((s) => (
        <div class="row skill rule-row">
          <span class="group">{s.group}</span>
          <span class="val">{s.items}</span>
        </div>
      ))}

      <SectionLabel top={64}>Education</SectionLabel>
      {resume.education.map((ed) => (
        <div class="row edu rule-row">
          <span class="group nums">{ed.years}</span>
          <span class="val">{ed.what} <span class="where">· {ed.where}</span></span>
        </div>
      ))}

      <p class="languages">{resume.languages}</p>
    </div>
  </div>
</BaseLayout>

<style>
  /* Layout has ONE switch, at 1024px. Below it the sidebar stacks above the text; from it
     the two sit side by side (280 + 72 gap + text column of ~560-640px, enough for the
     Experience rows to keep their years column). Both the column layout and the sidebar's
     stacked styling key off this same breakpoint, so they can never disagree. */
  .about {
    max-width: 1008px; margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; align-items: start;
  }
  @media (min-width: 1024px) {
    .about { grid-template-columns: 280px minmax(0, 640px); column-gap: 72px; }
  }
  aside { display: flex; flex-direction: column; gap: 24px; }
  .lines { font-size: 14px; line-height: 1.8; color: var(--color-neutral-700); }
  .actions { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }

  /* Identity block: a small vertical portrait hung on the column's left edge, with
     role/location set directly beneath it as its caption. No frame; the image takes the
     design system's .plate tone only (its mat would be tinted cream by the filter). */
  .identity { display: flex; flex-direction: column; gap: 16px; }
  .portrait { margin: 0; width: 176px; }
  .portrait img {
    display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover;
    filter: sepia(0.22) saturate(0.82) contrast(1.05);
  }
  /* Stacked layout (below 1024px): the sidebar becomes one block under the title. Portrait
     on the left at its own 3:4 proportion (it sets the block's height, never the text, so
     it can't be cropped to a strip); identity lines align to its top, the CV button to
     its bottom. Screen only, so the printed CV keeps its own layout. */
  @media screen and (max-width: 1023px) {
    aside {
      display: grid; grid-template-columns: clamp(104px, 30vw, 168px) 1fr; column-gap: 20px; row-gap: 0;
    }
    aside > h1 { grid-column: 1 / -1; margin-bottom: 28px; }
    .identity { display: contents; }
    .portrait { grid-column: 1; grid-row: 2 / span 2; width: auto; align-self: start; }
    .lines { grid-column: 2; grid-row: 2; margin-top: -0.4em; /* trim leading so text cap aligns with photo top */ }
    .actions { grid-column: 2; grid-row: 3; align-self: end; margin-top: 20px; }
  }

  .body { max-width: 640px; }
  .lead {
    margin: 0; font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 30px); line-height: 1.3; text-wrap: pretty;
  }
  .intro { margin: 28px 0 0; font-size: 16px; line-height: 1.7; }

  .exp { display: flex; flex-wrap: wrap; gap: 6px 24px; padding: 24px 0; }
  .years { flex: 0 0 120px; font-size: 13px; color: var(--color-neutral-600); }
  .exp-main { flex: 1 1 300px; display: flex; flex-direction: column; gap: 6px; }
  .exp-title { font-family: var(--font-heading); font-weight: 600; font-size: 22px; line-height: 1.2; }
  .org { font-size: 13px; }
  .exp-body { margin-top: 4px; font-size: 15px; line-height: 1.65; color: var(--color-neutral-700); }

  .row { display: flex; flex-wrap: wrap; gap: 4px 24px; padding: 16px 0; font-size: 15px; }
  .skill { line-height: 1.6; }
  .edu { line-height: 1.5; }
  .group { flex: 0 0 120px; font-size: 13px; color: var(--color-neutral-600); }
  .val { flex: 1 1 300px; }
  .where { color: var(--color-neutral-600); }

  .languages { margin: 40px 0 0; font-size: 15px; line-height: 1.6; color: var(--color-neutral-700); }
</style>
