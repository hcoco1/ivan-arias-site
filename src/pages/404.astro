---
import BaseLayout from '../layouts/BaseLayout.astro';
import RowLink from '../components/RowLink.astro';
import { NAV } from '../data/site';
---
<BaseLayout title="Page not found" description="This page isn't on the map." noindex>
  <div class="column column-640">
    <div class="numeral nums" aria-hidden="true">404</div>
    <h1>This page isn't on the map.</h1>
    <p>The link may be out of date, or the page has moved. Try one of these instead.</p>

    <div class="list rule-section-top">
      {NAV.map((n) => (
        <RowLink href={n.href} class="row">
          <span class="label">{n.label}</span>
          <span class="arrow accent" aria-hidden="true">→</span>
        </RowLink>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .numeral {
    font-family: var(--font-heading); font-weight: 400;
    font-size: clamp(120px, 24vw, 200px); line-height: .8; letter-spacing: -0.02em;
    color: var(--color-accent);
  }
  h1 {
    margin: 40px 0 0; font-family: var(--font-heading); font-weight: 400;
    font-size: clamp(36px, 5.5vw, 48px); line-height: 1.1; text-wrap: balance;
  }
  p { margin: 20px 0 0; font-size: 17px; line-height: 1.6; color: var(--color-neutral-700); text-wrap: pretty; }
  .list { margin-top: 48px; }
  .row { display: flex; align-items: baseline; justify-content: space-between; padding: 18px 0; }
  .label { font-family: var(--font-heading); font-weight: 600; font-size: 24px; }
  .arrow { font-size: 14px; }
</style>
